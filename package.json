{
  "name": "dsh-awesome-optimizer",
  "version": "4.5.0",
  "description": "Runtime policy guards, composite batch tooling, persistent Python & Node eval daemons, soft convergence guidance, reactive custom prompt engine, and A/B telemetry plugin for the official DeepSeek Harness (dsh) agent loop.",
  "type": "module",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./policy": {
      "types": "./src/runtime-policy.d.ts",
      "default": "./src/runtime-policy.js"
    },
    "./mutation-policy": {
      "types": "./src/file-mutation-policy.d.ts",
      "default": "./src/file-mutation-policy.js"
    },
    "./recovery": {
      "types": "./src/failure-recovery.d.ts",
      "default": "./src/failure-recovery.js"
    },
    "./edit-recovery": {
      "types": "./src/edit-recovery.d.ts",
      "default": "./src/edit-recovery.js"
    },
    "./read-guard": {
      "types": "./src/read-guard.d.ts",
      "default": "./src/read-guard.js"
    },
    "./context-compaction": {
      "types": "./src/context-compaction.d.ts",
      "default": "./src/context-compaction.js"
    },
    "./composite-tools": {
      "types": "./src/composite-tools.d.ts",
      "default": "./src/composite-tools.js"
    },
    "./persistent-eval": {
      "types": "./src/persistent-eval/index.d.ts",
      "default": "./src/persistent-eval/index.js"
    },
    "./convergence": {
      "types": "./src/convergence.d.ts",
      "default": "./src/convergence.js"
    },
    "./custom-prompt": {
      "types": "./src/custom-prompt.d.ts",
      "default": "./src/custom-prompt.js"
    },
    "./telemetry": {
      "types": "./src/telemetry.d.ts",
      "default": "./src/telemetry.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "scripts/setup-local.mjs",
    "scripts/typecheck.mjs",
    "scripts/benchmark.mjs",
    "scripts/benchmark-outline.mjs",
    "test",
    "tsconfig.json",
    "README.md",
    "README.zh.md",
    "cache-diagnostics.md",
    "outline-benchmark.md",
    "outline-benchmark.windows.json",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=10000 test/*.test.js",
    "typecheck": "node scripts/typecheck.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:outline": "node scripts/benchmark-outline.mjs"
  },
  "author": "Jaylor-Wang",
  "license": "MIT",
  "homepage": "https://github.com/Jaylor-Wang/dsh-awesome-optimizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaylor-Wang/dsh-awesome-optimizer.git"
  },
  "bugs": {
    "url": "https://github.com/Jaylor-Wang/dsh-awesome-optimizer/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-loop",
    "runtime-policy",
    "convergence",
    "telemetry",
    "composite-tools"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.3",
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.2-rc.3",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session": "0.2.2-rc.3",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.3",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.3",
    "typescript": "^5.9.3"
  }
}
